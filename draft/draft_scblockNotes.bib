@FOOTNOTE{Note1,key="Note1",note="The order of the two half-edges in an edge does not matter, since $\protect \mathbf  {G}^{AB}\Phi _A\Phi _B$ and $\protect \mathbf  {G}^{BA}\Phi _B\Phi _A$ have the same Grassmann sign."}
@FOOTNOTE{Note2,key="Note2",note="More explicitly, this is the Grassmann sign that arises from moving the operators from order $\DOTSB \prod@ \slimits@ _{e\in E_\protect \mathrm  {NS}\cup E_\protect \mathrm  {R}}\Phi _{e_1}\Phi _{e_2}$ to order $\DOTSB \prod@ \slimits@ _{v\in V_\protect \mathrm  {NS}}\Phi _{v_1}\Phi _{v_2}\Phi _{v_3}\DOTSB \prod@ \slimits@ _{v\in V_\protect \mathrm  {R}}\Phi _{v_1}\Phi _{v_2}\Phi _{v_3}$. It can be defined as $(-1)^{K_\Gamma (\epsilon )}=\DOTSB \sum@ \slimits@ _{(v_i, w_j)}\epsilon _{v_i}\epsilon _{w_j}$, where the sum is over pairs $(v_i, w_j)$ such that $v_i$ precedes $w_j$ in the pairwise insertion but the opposite in the 3-point functions"}
@FOOTNOTE{Note3,key="Note3",note="Supplemental materials"}
@FOOTNOTE{Note4,key="Note4",note="c=1 paper"}
@FOOTNOTE{Note5,key="Note5",note="We take the branch of $P$ as follows: For $h$ smaller than $Q^2/8$, $P$ is taken to be the positive root of $\protect \frac  {1}{4}Q^2-2h$. For $h$ greater than $Q^2/8$, we take $P=ip$ such that $p>0$. In the R-sector, $P$ is taken to be the positive root of $2\beta ^2$ for $\beta ^2 >0$ and the root with positive imaginary part for $\beta ^2 <0$"}
