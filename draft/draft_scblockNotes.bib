@FOOTNOTE{Note1,key="Note1",note="We take the branch of $P$ as follows: For $h$ smaller than $Q^2/8$, $P$ is taken to be the positive root of $\protect \frac  {1}{4}Q^2-2h$. For $h$ greater than $Q^2/8$, we take $P=ip$ such that $p>0$. In the R-sector, $P$ is taken to be the positive root of $2\beta ^2$ for $\beta ^2 >0$ and the root with positive imaginary part for $\beta ^2 <0$"}
